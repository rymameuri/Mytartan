REACT_APP_API_URL=http://localhost:3001
# Auth email links are built by the server (see server/.env.example):
#   JWT_SECRET, APP_PUBLIC_URL, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM
# Without SMTP, signup still works; reset/verify return an honest error instead of fake success.
# Optional: override mascot image path (default: /assets/scotty-tuxedo.png)
# REACT_APP_MASCOT_IMAGE=/assets/scotty-tuxedo.png
REACT_APP_CLAUDE_API_KEY=your_key
#REACT_APP_SIMLI_API_KEY=your_key
#REACT_APP_HEYGEN_API_KEY=your_key
#REACT_APP_HEYGEN_AVATAR_ID=your_avatar_id
