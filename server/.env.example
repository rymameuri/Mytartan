# CMU AI Gateway — Claude models for CMU students
# Set AI_PROVIDER=huggingface to use DeepSeek via Hugging Face instead of Claude.
AI_PROVIDER=claude
AI_GATEWAY_BASE_URL=https://ai-gateway.andrew.cmu.edu
# Available models (pick one):
#   claude-haiku-4-5-20251001-v1:0   (fast, default; gateway uses us.anthropic. prefix)
#   claude-sonnet-4-20250514-v1:0    (higher quality)
#   gpt-5-nano, gpt-5.4-mini         (OpenAI via gateway)
AI_MODEL=claude-haiku-4-5-20251001-v1:0
CLAUDE_API_KEY=your_key

# Or use Anthropic Claude directly (leave AI_GATEWAY_BASE_URL empty)
# ANTHROPIC_API_KEY=your_key

# Hugging Face Inference Providers (replaces Claude when AI_PROVIDER=huggingface)
# AI_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=hf_your_token
# HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Optional router override: HUGGINGFACE_ROUTER_BASE_URL=https://router.huggingface.co/v1
# Optional reasoning level for DeepSeek: HF_REASONING_EFFORT=low
LIVEAVATAR_API_KEY=your_key
LIVEAVATAR_AVATAR_ID=4166ad2e-a63e-400c-b3d6-09db5dfbfdfa
LIVEAVATAR_MODE=FULL
LIVEAVATAR_LANGUAGE=en
LIVEAVATAR_CONTEXT_ID=
LIVEAVATAR_VOICE_ID=5903397f-01dc-403c-a06b-057a82f52186
LIVEAVATAR_SANDBOX=false

# ElevenLabs — talking mascot voice (server-side TTS)
ELEVENLABS_API_KEY=sk_67f83d826f7a2e7038214ecaf7154f3ea6696cc2e00a24ca
ELEVENLABS_VOICE_ID=ljX1ZrXuDIIRVcmiVSyR
# Optional: eleven_flash_v2_5 (default, lower latency) or eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
PORT=3001
